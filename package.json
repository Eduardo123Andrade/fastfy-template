{
  "name": "fastify-auction-backend",
  "version": "0.0.1",
  "description": "Fastify Auction API",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "yarn prisma:generate && yarn db:up && tsx watch src/main.ts",
    "start:debug": "tsx --inspect src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --testMatch=\"**/test/unit/**/*.spec.ts\"",
    "test:integration": "jest --testMatch=\"**/test/integration/**/*.test.ts\"",
    "test:e2e": "jest --testMatch=\"**/test/e2e/**/*.e2e.spec.ts\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "db:up": "dotenv -- docker-compose up -d",
    "db:down": "dotenv -- docker-compose down",
    "db:psql": "dotenv -- docker exec -it postgres psql -U $DB_USERNAME -d $DB_DATABASE",
    "db:logs": "dotenv -- docker logs postgres",
    "db:kill-port": "sudo fuser -k 5432/tcp || echo 'No process on port 5432'",
    "end": "yarn db:down && kill $(lsof -ti :3000)",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "migration:migrate:dev": "prisma migrate dev",
    "migration:migrate:deploy": "prisma migrate deploy",
    "migration:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.1",
    "@prisma/client": "^6.8.2",
    "@types/nodemailer": "^6.4.17",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.4.0",
    "fastify-plugin": "^4.5.1",
    "nodemailer": "^7.0.3",
    "reflect-metadata": "^0.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.23.3",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.7.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.1.3"
  }
}
